<div class="mb-6 sm:mb-8">
  <h1 class="text-2xl font-bold text-foreground">Dashboard</h1>
</div>

<!-- KPI Cards -->
<div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-3 sm:gap-4 mb-6 sm:mb-8">
  <div class="bg-card border border-border rounded-lg p-4 sm:p-5">
    <p class="text-sm font-medium text-muted-foreground">Items In Stock</p>
    <p class="text-2xl font-bold text-card-foreground mt-1"><%= @total_items %></p>
    <p class="text-xs text-muted-foreground mt-1"><%= @items_drafted %> drafted, <%= @items_listed %> listed</p>
  </div>

  <div class="bg-card border border-border rounded-lg p-4 sm:p-5">
    <p class="text-sm font-medium text-muted-foreground">Total Invested</p>
    <p class="text-2xl font-bold text-card-foreground mt-1"><%= currency(@total_invested) %></p>
    <p class="text-xs text-muted-foreground mt-1">In current inventory</p>
  </div>

  <div class="bg-card border border-border rounded-lg p-4 sm:p-5">
    <p class="text-sm font-medium text-muted-foreground">Total Revenue</p>
    <p class="text-2xl font-bold text-success mt-1"><%= currency(@total_revenue) %></p>
    <p class="text-xs text-muted-foreground mt-1"><%= @total_sales_count %> items sold</p>
  </div>

  <div class="bg-card border border-border rounded-lg p-4 sm:p-5">
    <p class="text-sm font-medium text-muted-foreground">Avg Revenue/Sale</p>
    <p class="text-2xl font-bold text-card-foreground mt-1">
      <%= @total_sales_count > 0 ? currency(@total_revenue / @total_sales_count) : "-" %>
    </p>
  </div>

  <div class="bg-card border border-border rounded-lg p-4 sm:p-5">
    <p class="text-sm font-medium text-muted-foreground">Avg Gross Margin</p>
    <p class="text-2xl font-bold text-success mt-1">
      <%= @total_revenue > 0 ? number_to_percentage(@total_gross_profit / @total_revenue * 100, precision: 1) : "-" %>
    </p>
    <p class="text-xs text-muted-foreground mt-1"><%= currency(@total_sales_count > 0 ? @total_gross_profit / @total_sales_count : 0) %>/sale</p>
  </div>
</div>

<!-- Charts -->
<div class="grid grid-cols-1 lg:grid-cols-3 gap-4 sm:gap-6 mb-6 sm:mb-8">
  <div class="bg-card border border-border rounded-lg p-4 sm:p-6">
    <h2 class="text-lg font-semibold text-card-foreground mb-4">Revenue by Platform</h2>
    <%= bar_chart @sales_by_platform, prefix: "$" %>
  </div>

  <div class="bg-card border border-border rounded-lg p-4 sm:p-6">
    <h2 class="text-lg font-semibold text-card-foreground mb-4">Monthly Revenue</h2>
    <%= line_chart @sales_by_month, prefix: "$" %>
  </div>

  <div class="bg-card border border-border rounded-lg p-4 sm:p-6">
    <h2 class="text-lg font-semibold text-card-foreground mb-4">Monthly Gross Profit</h2>
    <%= line_chart @gross_profit_by_month, prefix: "$" %>
  </div>
</div>

<!-- Recent Activity -->
<div class="grid grid-cols-1 lg:grid-cols-2 gap-4 sm:gap-6">
  <div class="bg-card border border-border rounded-lg p-4 sm:p-6">
    <h2 class="text-lg font-semibold text-card-foreground mb-4">Recent Sales</h2>
    <% if @recent_sales.any? %>
      <div class="divide-y divide-border">
        <% @recent_sales.each do |sale| %>
          <div class="flex justify-between items-center py-3 first:pt-0 last:pb-0">
            <div class="min-w-0 mr-3">
              <%= link_to sale.item.sku, item_path(sale.item), class: "font-medium text-primary hover:underline" %>
              <span class="text-sm text-muted-foreground hidden sm:inline">on</span>
              <span class="text-sm text-muted-foreground"><%= sale.platform.name %></span>
            </div>
            <span class="font-semibold text-success shrink-0"><%= currency(sale.revenue_received) %></span>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-muted-foreground text-sm">No sales recorded yet.</p>
    <% end %>
  </div>

  <div class="bg-card border border-border rounded-lg p-4 sm:p-6">
    <h2 class="text-lg font-semibold text-card-foreground mb-4">Recent Items</h2>
    <% if @recent_items.any? %>
      <div class="divide-y divide-border">
        <% @recent_items.each do |item| %>
          <div class="flex justify-between items-center py-3 first:pt-0 last:pb-0">
            <div class="min-w-0 mr-3">
              <%= link_to item.sku, item_path(item), class: "font-medium text-primary hover:underline" %>
              <span class="text-sm text-muted-foreground"><%= item.brand&.name %></span>
            </div>
            <%= status_badge(item.status) %>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-muted-foreground text-sm">No items yet. <%= link_to "Add your first item", new_item_path, class: "text-primary hover:underline" %>.</p>
    <% end %>
  </div>
</div>
