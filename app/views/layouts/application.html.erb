<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "ThriftBot" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="ThriftBot">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-background text-foreground min-h-screen">
    <% if current_user %>
      <nav class="bg-card border-b border-border" data-controller="mobile-nav">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="flex justify-between h-16">
            <div class="flex items-center">
              <%= link_to "ThriftBot", root_path, class: "text-xl font-bold text-primary shrink-0" %>
              <div class="hidden md:flex items-center ml-8 space-x-1">
                <%= link_to "Dashboard", dashboard_path, class: "px-3 py-2 rounded-md text-sm font-medium transition-colors #{controller_name == 'dashboard' ? 'bg-accent text-accent-foreground' : 'text-muted-foreground hover:text-foreground hover:bg-accent'}" %>
                <%= link_to "Items", items_path, class: "px-3 py-2 rounded-md text-sm font-medium transition-colors #{controller_name == 'items' ? 'bg-accent text-accent-foreground' : 'text-muted-foreground hover:text-foreground hover:bg-accent'}" %>
                <%= link_to "Sales", sales_path, class: "px-3 py-2 rounded-md text-sm font-medium transition-colors #{controller_name == 'sales' ? 'bg-accent text-accent-foreground' : 'text-muted-foreground hover:text-foreground hover:bg-accent'}" %>
                <%= link_to "Imports", csv_imports_path, class: "px-3 py-2 rounded-md text-sm font-medium transition-colors #{controller_name == 'csv_imports' ? 'bg-accent text-accent-foreground' : 'text-muted-foreground hover:text-foreground hover:bg-accent'}" %>
              </div>
            </div>
            <div class="hidden md:flex items-center gap-2">
              <%= link_to "New Item", new_item_path, class: "btn btn-primary" %>
              <% if admin_user? %>
                <%= link_to "Admin", admin_root_path, class: "text-muted-foreground hover:text-foreground text-sm font-medium px-2 py-1.5 rounded-md transition-colors" %>
              <% end %>
              <%= link_to "Change Password", edit_password_path, class: "text-muted-foreground hover:text-foreground text-sm font-medium px-2 py-1.5 rounded-md transition-colors" %>
              <%= button_to "Log out", session_path, method: :delete, class: "text-muted-foreground hover:text-foreground text-sm font-medium px-2 py-1.5 rounded-md transition-colors" %>
            </div>
            <!-- Mobile hamburger button -->
            <div class="flex items-center md:hidden">
              <button type="button" data-action="mobile-nav#toggle" aria-label="Toggle navigation menu" aria-expanded="false" aria-controls="mobile-menu" class="inline-flex items-center justify-center p-2 rounded-md text-muted-foreground hover:text-foreground hover:bg-accent transition-colors">
                <svg data-mobile-nav-target="openIcon" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
                </svg>
                <svg data-mobile-nav-target="closeIcon" class="hidden h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                </svg>
              </button>
            </div>
          </div>
        </div>

        <!-- Mobile menu -->
        <div id="mobile-menu" data-mobile-nav-target="menu" class="hidden md:hidden border-t border-border">
          <div class="px-4 pt-3 pb-4 space-y-1">
            <%= link_to "Dashboard", dashboard_path, class: "block px-3 py-2.5 rounded-lg text-base font-medium transition-colors #{controller_name == 'dashboard' ? 'bg-accent text-accent-foreground' : 'text-muted-foreground hover:bg-accent'}" %>
            <%= link_to "Items", items_path, class: "block px-3 py-2.5 rounded-lg text-base font-medium transition-colors #{controller_name == 'items' ? 'bg-accent text-accent-foreground' : 'text-muted-foreground hover:bg-accent'}" %>
            <%= link_to "Sales", sales_path, class: "block px-3 py-2.5 rounded-lg text-base font-medium transition-colors #{controller_name == 'sales' ? 'bg-accent text-accent-foreground' : 'text-muted-foreground hover:bg-accent'}" %>
            <%= link_to "Imports", csv_imports_path, class: "block px-3 py-2.5 rounded-lg text-base font-medium transition-colors #{controller_name == 'csv_imports' ? 'bg-accent text-accent-foreground' : 'text-muted-foreground hover:bg-accent'}" %>
          </div>
          <div class="border-t border-border px-4 pt-3 pb-4 space-y-1">
            <%= link_to "New Item", new_item_path, class: "block px-3 py-2.5 rounded-lg text-base font-medium bg-primary text-primary-foreground text-center hover:opacity-90 transition-colors" %>
            <% if admin_user? %>
              <%= link_to "Admin", admin_root_path, class: "block px-3 py-2.5 rounded-lg text-base font-medium text-muted-foreground hover:bg-accent transition-colors" %>
            <% end %>
            <%= link_to "Change Password", edit_password_path, class: "block px-3 py-2.5 rounded-lg text-base font-medium text-muted-foreground hover:bg-accent transition-colors" %>
            <%= button_to "Log out", session_path, method: :delete, class: "block w-full text-left px-3 py-2.5 rounded-lg text-base font-medium text-muted-foreground hover:bg-accent transition-colors" %>
          </div>
        </div>
      </nav>
    <% end %>

    <% if notice.present? %>
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-4" data-controller="flash">
        <div class="bg-success/10 border border-success/20 text-success px-4 py-3 rounded-lg flex items-center justify-between" role="alert">
          <span class="text-sm font-medium"><%= notice %></span>
          <button type="button" data-action="flash#dismiss" aria-label="Dismiss notification" class="ml-4 text-success/60 hover:text-success">
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
      </div>
    <% end %>

    <% if alert.present? %>
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-4" data-controller="flash">
        <div class="bg-destructive/10 border border-destructive/20 text-destructive px-4 py-3 rounded-lg flex items-center justify-between" role="alert">
          <span class="text-sm font-medium"><%= alert %></span>
          <button type="button" data-action="flash#dismiss" aria-label="Dismiss notification" class="ml-4 text-destructive/60 hover:text-destructive">
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
      </div>
    <% end %>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-8">
      <%= yield %>
    </main>

    <!-- Floating Feedback Button -->
    <a href="https://github.com/Dolphin-Web-Dynamics/thriftbot/issues/new?template=bug-report.yml"
       target="_blank"
       rel="noopener noreferrer"
       class="fixed bottom-6 right-6 btn btn-primary shadow-lg hover:shadow-xl transition-all flex items-center gap-2 z-50"
       aria-label="Report Bug">
      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 12.75c1.148 0 2.278.08 3.383.237 1.037.146 1.866.966 1.866 2.013 0 3.728-2.35 6.75-5.25 6.75S6.75 18.728 6.75 15c0-1.046.83-1.867 1.866-2.013A24.204 24.204 0 0 1 12 12.75Zm0 0c2.883 0 5.647.508 8.207 1.44a23.91 23.91 0 0 1-1.152-6.135 3.082 3.082 0 0 0-2.8-2.927A24.04 24.04 0 0 0 12 4.875c-1.44 0-2.848.13-4.255.253a3.082 3.082 0 0 0-2.8 2.927 23.91 23.91 0 0 1-1.152 6.135A23.93 23.93 0 0 1 12 12.75ZM9.75 8.625a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm4.5 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z" />
      </svg>
      <span class="hidden sm:inline">Report Bug</span>
    </a>
  </body>
</html>
