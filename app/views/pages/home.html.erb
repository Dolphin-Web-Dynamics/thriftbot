</section>

<!-- ========== HOW IT WORKS ========== -->
<section class="py-16 sm:py-24" data-controller="scroll-reveal">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-14 scroll-reveal">
      <h2 class="text-2xl sm:text-3xl font-bold text-foreground font-display">Up and running in 5 minutes</h2>
      <p class="mt-3 text-muted-foreground text-lg">No onboarding calls. No setup fees. Just start.</p>
    </div>

    <div class="grid md:grid-cols-3 gap-8 max-w-4xl mx-auto">
      <div class="text-center scroll-reveal">
        <div class="w-12 h-12 bg-primary text-primary-foreground rounded-full flex items-center justify-center text-lg font-bold mx-auto mb-4 font-mono">1</div>
        <h3 class="font-semibold text-foreground mb-2">Add your inventory</h3>
        <p class="text-sm text-muted-foreground">Type it in or import a CSV. Costs, brands, condition, photos — all captured in one place.</p>
      </div>

      <div class="text-center scroll-reveal">
        <div class="w-12 h-12 bg-primary text-primary-foreground rounded-full flex items-center justify-center text-lg font-bold mx-auto mb-4 font-mono">2</div>
        <h3 class="font-semibold text-foreground mb-2">List across platforms</h3>
        <p class="text-sm text-muted-foreground">Track what's listed where with platform-specific pricing. One view, all your listings.</p>
      </div>

      <div class="text-center scroll-reveal">
        <div class="w-12 h-12 bg-primary text-primary-foreground rounded-full flex items-center justify-center text-lg font-bold mx-auto mb-4 font-mono">3</div>
        <h3 class="font-semibold text-foreground mb-2">See your real numbers</h3>
        <p class="text-sm text-muted-foreground">Record sales, track profit after all fees, and watch your analytics grow. Make smarter sourcing decisions.</p>
      </div>
    </div>
  </div>
</section>

<!-- ========== PRICING ========== -->
<section class="py-16 sm:py-24 bg-card/50" id="pricing" data-controller="scroll-reveal">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-4 scroll-reveal">
      <h2 class="text-2xl sm:text-3xl font-bold text-foreground font-display">Simple, honest pricing</h2>
      <p class="mt-3 text-muted-foreground text-lg">Start free. Upgrade when your closet outgrows it.</p>
    </div>
    <p class="text-center text-sm text-primary font-semibold mb-12 scroll-reveal">14-day free trial on all paid plans. No credit card required.</p>

    <div class="grid md:grid-cols-3 gap-5 max-w-4xl mx-auto">
      <!-- Free -->
      <div class="bg-card border border-border rounded-xl p-7 flex flex-col scroll-reveal">
        <h3 class="text-lg font-bold text-card-foreground mb-1">Free</h3>
        <p class="text-sm text-muted-foreground mb-4">For getting started</p>
        <div class="mb-5">
          <span class="text-4xl font-bold text-card-foreground font-display">$0</span>
          <span class="text-muted-foreground text-sm">/month</span>
        </div>
        <ul class="space-y-2.5 mb-8 text-sm text-foreground flex-1">
          <li class="flex items-start gap-2"><svg class="w-4 h-4 text-success mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/></svg>Up to <%= User::FREE_TIER_ITEM_LIMIT %> items</li>
          <li class="flex items-start gap-2"><svg class="w-4 h-4 text-success mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/></svg>Multi-platform listings</li>
          <li class="flex items-start gap-2"><svg class="w-4 h-4 text-success mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/></svg>Sales tracking</li>
          <li class="flex items-start gap-2"><svg class="w-4 h-4 text-success mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/></svg>CSV import</li>
        </ul>
        <%= link_to "Get started free", new_registration_path, class: "btn btn-secondary w-full text-center py-2.5" %>
      </div>

      <!-- Pro -->
      <div class="bg-card border-2 border-primary rounded-xl p-7 relative flex flex-col shadow-lg shadow-primary/10 scroll-reveal">
        <span class="absolute -top-3 left-1/2 -translate-x-1/2 bg-primary text-primary-foreground text-xs font-bold px-3 py-1 rounded-full tracking-wide font-mono">POPULAR</span>
        <h3 class="text-lg font-bold text-card-foreground mb-1">Pro</h3>
        <p class="text-sm text-muted-foreground mb-4">For growing resellers</p>
        <div class="mb-5">
          <span class="text-4xl font-bold text-card-foreground font-display">$9</span>
          <span class="text-muted-foreground text-sm">/month</span>
