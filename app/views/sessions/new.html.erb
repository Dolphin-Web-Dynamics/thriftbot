<div class="min-h-[60vh] flex items-center justify-center">
  <div class="w-full max-w-md">
    <div class="bg-card border border-border shadow-sm rounded-xl px-8 py-10">
      <h1 class="text-2xl font-bold text-card-foreground text-center mb-8">Log in to ThriftBot</h1>

      <%= form_with url: session_path, class: "space-y-6" do |f| %>
        <div>
          <%= f.label :email_address, "Email", class: "block text-sm font-medium text-foreground mb-1" %>
          <%= f.email_field :email_address, autofocus: true, autocomplete: "email", required: true, class: "input" %>
        </div>

        <div>
          <%= f.label :password, class: "block text-sm font-medium text-foreground mb-1" %>
          <%= f.password_field :password, autocomplete: "current-password", required: true, class: "input" %>
        </div>

        <%= f.submit "Log in", class: "w-full btn btn-primary py-2.5 cursor-pointer" %>
      <% end %>

      <div class="flex items-center my-6">
        <div class="flex-grow border-t border-border"></div>
        <span class="px-3 text-sm text-muted-foreground">or</span>
        <div class="flex-grow border-t border-border"></div>
      </div>

      <%= button_to "/auth/google_oauth2", method: :post, data: { turbo: false }, class: "w-full inline-flex items-center justify-center gap-3 rounded-lg border border-border bg-card px-4 py-2.5 text-sm font-medium text-card-foreground shadow-sm hover:bg-accent transition-colors cursor-pointer" do %>
        <svg width="18" height="18" viewBox="0 0 48 48"><path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/><path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/><path fill="#FBBC05" d="M10.53 28.59a14.5 14.5 0 0 1 0-9.18l-7.98-6.19a24.01 24.01 0 0 0 0 21.56l7.98-6.19z"/><path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/></svg>
        Sign in with Google
      <% end %>

      <p class="text-center text-sm text-muted-foreground mt-6">
        Don't have an account? <%= link_to "Sign up", new_registration_path, class: "text-primary hover:underline font-medium" %>
      </p>
    </div>
  </div>
</div>
