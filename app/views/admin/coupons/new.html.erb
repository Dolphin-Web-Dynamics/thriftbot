<% content_for(:title, "New Coupon — Admin") %>

<div class="mb-6">
  <%= link_to "&larr; Back to Coupons".html_safe, admin_coupons_path, class: "text-sm text-muted-foreground hover:text-foreground" %>
</div>

<h1 class="text-2xl font-bold mb-6">New Coupon</h1>

<div class="bg-card border border-border rounded-lg p-6 max-w-lg">
  <%= form_with url: admin_coupons_path, method: :post do |f| %>
    <div class="space-y-4">
      <div>
        <%= f.label :name, "Coupon Name", class: "block text-sm font-medium mb-1" %>
        <%= f.text_field :name, class: "input w-full", required: true, placeholder: "e.g. Summer Sale" %>
      </div>

      <div>
        <%= f.label :discount_type, "Discount Type", class: "block text-sm font-medium mb-1" %>
        <%= f.select :discount_type, [["Percentage", "percent"], ["Fixed Amount", "amount"]], {}, class: "input w-full" %>
      </div>

      <div>
        <%= f.label :percent_off, "Percent Off", class: "block text-sm font-medium mb-1" %>
        <%= f.number_field :percent_off, class: "input w-full", min: 1, max: 100, step: 1, placeholder: "e.g. 20" %>
      </div>

      <div>
        <%= f.label :amount_off, "Amount Off (USD)", class: "block text-sm font-medium mb-1" %>
        <%= f.number_field :amount_off, class: "input w-full", min: 0.5, step: 0.01, placeholder: "e.g. 5.00" %>
      </div>

      <div>
        <%= f.label :duration, class: "block text-sm font-medium mb-1" %>
        <%= f.select :duration, [["Once", "once"], ["Repeating", "repeating"], ["Forever", "forever"]], {}, class: "input w-full" %>
      </div>

      <div>
        <%= f.label :duration_in_months, "Duration (months)", class: "block text-sm font-medium mb-1" %>
        <%= f.number_field :duration_in_months, class: "input w-full", min: 1, placeholder: "Only for 'repeating' duration" %>
      </div>

      <div>
        <%= f.label :promo_code, "Promo Code (optional)", class: "block text-sm font-medium mb-1" %>
        <%= f.text_field :promo_code, class: "input w-full", placeholder: "e.g. SAVE20" %>
        <p class="text-xs text-muted-foreground mt-1">If set, users enter this code at checkout.</p>
      </div>

      <div class="pt-2">
        <%= f.submit "Create Coupon", class: "btn btn-primary" %>
      </div>
    </div>
  <% end %>
</div>
