<% content_for(:title, "Coupons — Admin") %>

<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-bold">Coupons</h1>
  <%= link_to "New Coupon", new_admin_coupon_path, class: "btn btn-primary text-sm" %>
</div>

<div class="bg-card border border-border rounded-lg overflow-hidden">
  <div class="overflow-x-auto">
    <table class="w-full text-sm">
      <thead>
        <tr class="border-b border-border bg-muted/50">
          <th class="text-left px-4 py-3 font-medium text-muted-foreground">Name</th>
          <th class="text-left px-4 py-3 font-medium text-muted-foreground">Discount</th>
          <th class="text-left px-4 py-3 font-medium text-muted-foreground">Duration</th>
          <th class="text-left px-4 py-3 font-medium text-muted-foreground">Promo Code</th>
          <th class="text-left px-4 py-3 font-medium text-muted-foreground">Times Used</th>
        </tr>
      </thead>
      <tbody>
        <% if @coupons.any? %>
          <% @coupons.each do |coupon| %>
            <% promo = @promotion_codes.find { |p| p.coupon.id == coupon.id } %>
            <tr class="border-b border-border last:border-0 hover:bg-muted/30 transition-colors">
              <td class="px-4 py-3 font-medium"><%= coupon.name || coupon.id %></td>
              <td class="px-4 py-3">
                <% if coupon.percent_off %>
                  <%= coupon.percent_off %>% off
                <% elsif coupon.amount_off %>
                  <%= number_to_currency(coupon.amount_off / 100.0) %> off
                <% end %>
              </td>
              <td class="px-4 py-3 text-muted-foreground">
                <%= coupon.duration.titleize %>
                <%= "(#{coupon.duration_in_months} mo)" if coupon.duration == "repeating" %>
              </td>
              <td class="px-4 py-3">
                <% if promo %>
                  <code class="bg-muted px-2 py-0.5 rounded text-xs"><%= promo.code %></code>
                <% else %>
                  <span class="text-muted-foreground">—</span>
                <% end %>
              </td>
              <td class="px-4 py-3 text-muted-foreground"><%= coupon.times_redeemed %></td>
            </tr>
          <% end %>
        <% else %>
          <tr>
            <td colspan="5" class="px-4 py-8 text-center text-muted-foreground">No coupons yet.</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
