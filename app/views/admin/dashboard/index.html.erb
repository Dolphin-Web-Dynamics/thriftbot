<% content_for(:title, "Admin Dashboard — ThriftBot") %>

<h1 class="text-2xl font-bold mb-6">Dashboard</h1>

<!-- KPI Cards -->
<div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
  <div class="bg-card border border-border rounded-lg p-4">
    <p class="text-sm text-muted-foreground">Total Users</p>
    <p class="text-2xl font-bold mt-1"><%= @total_users %></p>
  </div>
  <div class="bg-card border border-border rounded-lg p-4">
    <p class="text-sm text-muted-foreground">Active Subscribers</p>
    <p class="text-2xl font-bold mt-1"><%= @active_subscribers %></p>
  </div>
  <div class="bg-card border border-border rounded-lg p-4">
    <p class="text-sm text-muted-foreground">Estimated MRR</p>
    <p class="text-2xl font-bold mt-1"><%= number_to_currency(@estimated_mrr) %></p>
  </div>
  <div class="bg-card border border-border rounded-lg p-4">
    <p class="text-sm text-muted-foreground">Total Items</p>
    <p class="text-2xl font-bold mt-1"><%= number_with_delimiter(@total_items) %></p>
  </div>
</div>

<!-- Secondary stats -->
<div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
  <div class="bg-card border border-border rounded-lg p-4">
    <p class="text-sm text-muted-foreground">Trialing</p>
    <p class="text-xl font-semibold mt-1"><%= @trialing_users %></p>
  </div>
  <div class="bg-card border border-border rounded-lg p-4">
    <p class="text-sm text-muted-foreground">Canceled</p>
    <p class="text-xl font-semibold mt-1"><%= @canceled_users %></p>
  </div>
  <div class="bg-card border border-border rounded-lg p-4">
    <p class="text-sm text-muted-foreground">Total Sales</p>
    <p class="text-xl font-semibold mt-1"><%= number_with_delimiter(@total_sales) %></p>
  </div>
  <div class="bg-card border border-border rounded-lg p-4">
    <p class="text-sm text-muted-foreground">Total Revenue</p>
    <p class="text-xl font-semibold mt-1"><%= number_to_currency(@total_revenue) %></p>
  </div>
</div>

<!-- Charts -->
<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
  <div class="bg-card border border-border rounded-lg p-4">
    <h3 class="text-sm font-semibold text-muted-foreground mb-3">Signups (Last 12 Months)</h3>
    <%= line_chart @signups_by_month, colors: ["hsl(var(--primary))"], library: { scales: { y: { beginAtZero: true } } } %>
  </div>
  <div class="bg-card border border-border rounded-lg p-4">
    <h3 class="text-sm font-semibold text-muted-foreground mb-3">Cancellations (Last 12 Months)</h3>
    <%= column_chart @cancellations_by_month, colors: ["hsl(var(--destructive))"], library: { scales: { y: { beginAtZero: true } } } %>
  </div>
</div>

<!-- Plan distribution -->
<div class="bg-card border border-border rounded-lg p-4">
  <h3 class="text-sm font-semibold text-muted-foreground mb-3">Users by Plan</h3>
  <%= pie_chart @users_by_plan, donut: true, colors: ["hsl(var(--muted-foreground))", "hsl(var(--primary))", "hsl(var(--chart-3))"] %>
</div>
